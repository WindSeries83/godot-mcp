{
  "name": "godot-mcp",
  "version": "0.1.0",
  "description": "MCP bridge for Godot editor — call any addon method via WebSocket JSON-RPC",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "godot-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:godot": "node scripts/run-godot-tests.mjs",
    "contract": "node scripts/contract-check.mjs",
    "token-cost": "node scripts/token-cost.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  },
  "license": "MIT"
}
